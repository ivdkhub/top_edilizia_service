# Copia in .env.local per lo sviluppo locale; in produzione impostale su Vercel.
# Senza TURSO_DATABASE_URL, in sviluppo si usa il file locale .data/local.db.
TURSO_DATABASE_URL=libsql://<nome-db>-<utente>.turso.io
TURSO_AUTH_TOKEN=
# Password dell'area /admin
ADMIN_PASSWORD=
# Stringa casuale di almeno 32 caratteri (es. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
